# Frontend Environment Variables
# Copy this file to .env.local, .env.development, .env.staging, or .env.production
# Next.js automatically loads the appropriate file based on NODE_ENV

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Backend API URL (used by API routes when calling the backend)
# API_URL = server-side only; use when backend runs locally (e.g. API_URL=http://localhost:5001)
# NEXT_PUBLIC_API_URL = fallback (client + server)
NEXT_PUBLIC_API_URL=http://localhost:5001

